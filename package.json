{
  "name": "loomjs",
  "version": "1.0.0",
  "description": "A lightweight JSX-based UI library",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/index.esm.js",
    "build:cjs": "esbuild src/index.tsx --bundle --format=cjs --outfile=dist/index.js",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "esbuild examples/counter-demo.tsx --bundle --outfile=dist/demo.js --watch --servedir=.",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jsx",
    "ui",
    "library",
    "reactive"
  ],
  "author": "Your Name",
  "devDependencies": {
    "esbuild": "^0.25.11",
    "typescript": "^5.0.0"
  }
}
