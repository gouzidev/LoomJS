{
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "createElement",
    "target": "ES6",
    "module": "ES6",
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES6", "DOM"]
  },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
